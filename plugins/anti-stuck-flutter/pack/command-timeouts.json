{
  "_doc": "Flutter time limits. Installed into ~/.anti-stuck/packs/flutter/ at session start; the anti-stuck core reads it.",
  "rules": [
    {"pattern": "(anti-stuck-flutter|devctl) (run|emu|exec|build)", "limit": 1500},
    {"pattern": "flutter build (apk|appbundle|web)", "limit": 900},
    {"pattern": "flutter build (ios|ipa|macos)", "limit": 1500},
    {"pattern": "pod (install|update)", "limit": 900},
    {"pattern": "gradlew", "limit": 900},
    {"pattern": "fastlane", "limit": 1800},
    {"pattern": "flutter test .*integration_test|patrol (test|develop)", "limit": 1500},
    {"pattern": "flutter test .*--tags stress", "limit": 900}
  ]
}
