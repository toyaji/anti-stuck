#!/usr/bin/env python3
"""anti-stuck-flutter — share real devices, emulators and heavy builds between Claude Code sessions through one ledger.

Ledger: $ANTI_STUCK_HOME/state/devices/ledger.json (default ~/.anti-stuck; shared by every session, file-locked)
Session identity: the Claude Code process that called this command. When it dies, its ownership is released.

  anti-stuck-flutter status                         who uses what, waiters, app build (branch@commit) and Marionette address
  anti-stuck-flutter attach <device> [attach args]  take the device, launch the already-installed app and attach (no Xcode/Gradle build)
  anti-stuck-flutter run <device> [flutter run args] take the device and start the app (reuses my app if it is already up)
  anti-stuck-flutter reload|restart <device>        how to hot reload / hot restart through Marionette, with the address
  anti-stuck-flutter exec <device> -- <command>     take the device and run a command (integration test, adb install, ...)
  anti-stuck-flutter emu <avd>                      boot an emulator and take it
  anti-stuck-flutter build -- <command>             heavy build, one at a time across sessions; released when it ends
  anti-stuck-flutter wait <device> [purpose]        join the waiters of a device another session is using. A hook wakes this
                                        session as soon as the device is free; the first waiter to take it gets it
  anti-stuck-flutter release <device>               release ownership only. The app keeps running and the device becomes free
  anti-stuck-flutter release-all                    release every device this session holds (the Stop hook calls this). Apps keep running
  anti-stuck-flutter stop <device>                  stop the app (and an emulator it started) and remove it. Not allowed on someone else's device
"""
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import time

HOME = os.environ.get('ANTI_STUCK_HOME') or os.path.expanduser('~/.anti-stuck')
STATE = os.path.join(HOME, 'state', 'devices')
LEDGER = os.path.join(STATE, 'ledger.json')
LOCK = os.path.join(STATE, 'ledger.lock')
URI_RE = re.compile(r'(http://127\.0\.0\.1:\d+/[A-Za-z0-9_=\-]+=/)')
IOS_SIM_RE = re.compile(r'^[0-9A-F]{8}-([0-9A-F]{4}-){3}[0-9A-F]{12}$', re.I)
IOS_DEV_RE = re.compile(r'^[0-9A-F]{8}-[0-9A-F]{16}$', re.I)
RUN_WAIT_SEC = 1400
ATTACH_WAIT_SEC = 60
FREE_APP_TTL_SEC = 15 * 60
TOOL = os.path.abspath(__file__)  # messages give Claude the exact path to call


# ───── session · ledger ─────

def session():
    forced = os.environ.get('ANTI_STUCK_SESSION_PID')  # tests: act as another session
    if forced:
        return {'pid': int(forced), 'label': f'pid{forced}', 'cwd': os.getcwd()}
    pid = os.getpid()
    for _ in range(12):
        out = subprocess.run(['ps', '-o', 'ppid=,command=', '-p', str(pid)], capture_output=True, text=True).stdout.strip()
        if not out:
            break
        ppid, cmd = out.split(None, 1)
        if re.search(r'claude\.app/Contents/MacOS/claude|/claude(\s|$)|^claude(\s|$)|\bclaude-code\b', cmd) and 'devctl' not in cmd and 'anti-stuck-flutter' not in cmd:
            return {'pid': pid, 'label': os.environ.get('CLAUDE_CODE_HOST_SESSION_ID', f'pid{pid}'), 'cwd': os.getcwd()}
        pid = int(ppid)
        if pid <= 1:
            break
    return {'pid': os.getppid(), 'label': os.environ.get('CLAUDE_CODE_HOST_SESSION_ID', f'pid{os.getppid()}'), 'cwd': os.getcwd()}


def alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


class Ledger:
    def __enter__(self):
        os.makedirs(STATE, exist_ok=True)
        self.f = open(LOCK, 'w')
        fcntl.flock(self.f, fcntl.LOCK_EX)
        try:
            self.data = json.load(open(LEDGER))
        except (OSError, ValueError):
            self.data = {'devices': {}}
        self._sweep()
        return self

    def __exit__(self, *exc):
        tmp = LEDGER + '.tmp'
        json.dump(self.data, open(tmp, 'w'), indent=2)
        os.replace(tmp, LEDGER)
        fcntl.flock(self.f, fcntl.LOCK_UN)

    @property
    def devices(self):
        return self.data['devices']

    def _sweep(self):
        """Drop dead waiters; if the owner session died, keep the app and hand it on or leave it free.
        Only a device left free for FREE_APP_TTL_SEC gets its app/emulator stopped."""
        for key in list(self.devices):
            d = self.devices[key]
            d['waiters'] = [w for w in d.get('waiters', []) if alive(w['pid'])]
            app = d.get('app')
            if app and not alive(app.get('pid')):
                d['app'] = None
            owner = d.get('owner')
            if owner and not alive(owner['pid']):
                free_device(self, key)
            elif not owner and not d['waiters'] and time.time() - d.get('free_at', time.time()) > FREE_APP_TTL_SEC:
                retire_device(self, key)


def now():
    return time.strftime('%Y-%m-%d %H:%M:%S')


def git_info(cwd):
    def g(*a):
        return subprocess.run(['git', '-C', cwd, *a], capture_output=True, text=True).stdout.strip()
    return {'branch': g('rev-parse', '--abbrev-ref', 'HEAD'), 'head': g('rev-parse', '--short', 'HEAD'),
            'dirty': bool(g('status', '--porcelain', '--untracked-files=no'))}


def describe(key, d, me=None):
    o = d.get('owner')
    if o:
        mine = ' (me)' if me and o['pid'] == me['pid'] else ''
        lines = [f"■ {key} — in use by {o['label']}{mine}  purpose: {d.get('purpose') or '-'}  since {d['since']}",
                 f"    working dir: {o['cwd']}"]
    else:
        lines = [f"□ {key} — free (no owner since {d.get('free_since', '-')}). A running app can be reused as is — {TOOL} run {key}"]
    app = d.get('app')
    if app:
        lines.append(f"    app: pid {app['pid']}  {app['branch']}@{app['head']}{' (with uncommitted changes)' if app.get('dirty') else ''}  started {app['started']}")
        lines.append(f"    Marionette: {app.get('ws') or '(waiting for VM address)'}   log: {app['log']}")
    if d.get('emulator_pid'):
        lines.append(f"    emulator pid {d['emulator_pid']} (started by anti-stuck-flutter)")
    for i, w in enumerate(d.get('waiters', []), 1):
        lines.append(f"    waiter {i}: {w['label']}  purpose: {w.get('purpose') or '-'}  since {w['since']}  ({w['cwd']})")
    return '\n'.join(lines)


def stop_app(app):
    if not app:
        return
    try:
        with open(app['fifo'], 'w') as f:
            f.write('q\n')
    except OSError:
        pass
    for _ in range(20):
        if not alive(app['pid']):
            break
        time.sleep(0.25)
    if alive(app['pid']):
        try:
            os.killpg(app['pid'], signal.SIGTERM)
        except OSError:
            pass


def free_device(led, key):
    """Release ownership only (waiters are present, or the session merely went idle). Apps and emulators keep running
    and the device becomes free. Waiters are not handed
    the device: their wait_watch hooks see it free and wake them, and the first one to take it gets it."""
    d = led.devices[key]
    d['owner'] = None
    d['purpose'] = None
    d['free_since'] = now()
    d['free_at'] = time.time()
    if not d.get('app') and not d.get('emulator_pid') and not d.get('waiters'):
        del led.devices[key]
        return f"{key}: released (no app running)."
    waiting = len(d.get('waiters', []))
    note = f' {waiting} waiting session(s) are being woken; the first to take it gets it.' if waiting else ''
    return (f"{key}: released. The app keeps running and the device is free (cleaned up after "
            f"{FREE_APP_TTL_SEC // 60} min unused, screen turned off).{note}")


def kill_device(led, key):
    """Stop the app and an emulator this tool started, and remove the device from the ledger."""
    d = led.devices[key]
    stop_app(d.get('app'))
    if d.get('emulator_pid') and alive(d['emulator_pid']):
        subprocess.run(['adb', '-s', key, 'emu', 'kill'], capture_output=True, timeout=15)
        time.sleep(1)
        if alive(d['emulator_pid']):
            os.kill(d['emulator_pid'], signal.SIGTERM)
    del led.devices[key]
    stopped = ' and '.join(x for x, on in (('the app', d.get('app')), ('the emulator', d.get('emulator_pid'))) if on)
    return f"{key}: {'stopped ' + stopped + ' and ' if stopped else ''}removed it from the ledger."


def screen_off(key):
    """Turn off a real Android device's screen (it locks if a lock is set). Other devices are left as they are."""
    try:
        out = subprocess.run(['adb', 'devices'], capture_output=True, text=True, timeout=15).stdout
        if key.startswith('emulator-') or not re.search(rf'^{re.escape(key)}\s+device\b', out, re.M):
            return ''
        subprocess.run(['adb', '-s', key, 'shell', 'input', 'keyevent', 'KEYCODE_SLEEP'], capture_output=True, timeout=15)
        return ' Screen turned off.'
    except (OSError, subprocess.TimeoutExpired):
        return ''


def retire_device(led, key):
    """Nobody needs the device any more: stop its app (and emulator), drop it from the ledger, and turn its screen off."""
    return kill_device(led, key) + screen_off(key)


def take(led, key, me, purpose):
    """Take a device. If another session uses it, return None and guidance. A free device is taken with its app as is."""
    d = led.devices.get(key)
    if d and d.get('owner') and d['owner']['pid'] != me['pid']:
        return None, (describe(key, d, me) + f"\n-> Another session is using it. Do not stop it or start a new app — "
                      f"`{TOOL} wait {key} \"purpose\"`. This session is woken as soon as the device is free; "
                      "then take it right away if you will use it now.")
    if not d:
        d = led.devices[key] = {'owner': None, 'purpose': purpose, 'since': now(), 'app': None, 'waiters': []}
    if not d.get('owner'):
        d['since'] = now()
    d['owner'] = {k: me[k] for k in ('pid', 'label', 'cwd')}
    d.pop('free_at', None)
    d.pop('free_since', None)
    d['waiters'] = [w for w in d.get('waiters', []) if w['pid'] != me['pid']]
    if purpose:
        d['purpose'] = purpose
    return d, None


# ───── commands ─────

def cmd_status(_args, me):
    with Ledger() as led:
        if not led.devices:
            print('no devices or builds in use')
        for key, d in led.devices.items():
            print(describe(key, d, me))


def cmd_wait(args, me):
    key, purpose = args[0], ' '.join(args[1:])
    with Ledger() as led:
        d = led.devices.get(key)
        if not d:
            print(f'{key}: nobody is using it. Use it directly.')
            return
        if not d.get('owner'):
            print(f'{key}: free (app still running). Use it directly — {TOOL} run {key}')
            return
        if d['owner']['pid'] == me['pid']:
            print(f'{key}: already mine.')
            return
        if not any(w['pid'] == me['pid'] for w in d['waiters']):
            d['waiters'].append({**{k: me[k] for k in ('pid', 'label', 'cwd')}, 'purpose': purpose, 'since': now()})
        pos = [w['pid'] for w in d['waiters']].index(me['pid']) + 1
        print(describe(key, d, me) + f'\n-> waiting ({pos} of {len(d["waiters"])}). This session will be woken when {key} is free; '
              'you can keep working on something else or stop until then. When woken, take it only if you will use it now.')


def cmd_release(args, me):
    key = args[0]
    with Ledger() as led:
        d = led.devices.get(key)
        if not d:
            print(f'{key}: not held.')
            return
        if not d.get('owner'):
            print(f'{key}: already free.')
            return
        if d['owner']['pid'] != me['pid']:
            sys.exit(f"{key}: owned by {d['owner']['label']}. You cannot release someone else's device.")
        # Keep the running app alive so the next turn/session can reuse it in 0 s; _sweep retires it after FREE_APP_TTL_SEC.
        print(free_device(led, key))


def cmd_stop(args, me):
    key = args[0]
    with Ledger() as led:
        d = led.devices.get(key)
        if not d:
            print(f'{key}: not held.')
            return
        if d.get('owner') and d['owner']['pid'] != me['pid']:
            sys.exit(f"{key}: {d['owner']['label']} is using it, so it cannot be stopped. `{TOOL} wait {key}` instead.")
        if d.get('waiters'):
            sys.exit(f"{key}: sessions are waiting for it, so it is not stopped. `{TOOL} release {key}` frees it for them.")
        print(kill_device(led, key))


def cmd_release_all(_args, me):
    with Ledger() as led:
        mine = [k for k, d in led.devices.items() if d.get('owner') and d['owner']['pid'] == me['pid']]
        for key in mine:
            print(free_device(led, key))


def cmd_send(args, me, key_char):
    key = args[0]
    with Ledger() as led:
        d = led.devices.get(key)
        if not d or not d.get('app'):
            sys.exit(f'{key}: no app running. Start it with {TOOL} attach {key} (or {TOOL} run {key}).')
        if d.get('owner') and d['owner']['pid'] != me['pid']:
            sys.exit(describe(key, d, me) + f'\n-> someone else\'s app. `{TOOL} wait {key}`.')
        ws = d['app'].get('ws')
    tool = 'hot_reload' if key_char == 'r' else 'hot_restart'
    sys.exit(f"{key}: flutter run does not take keys from a pipe. Connect with Marionette (connect {ws}) and use its {tool} tool.")


def ios_bundle_id(cwd):
    override = os.environ.get('CLAUDE_PLUGIN_OPTION_IOS_BUNDLE_ID')
    if override:
        return override
    try:
        src = open(os.path.join(cwd, 'ios', 'Runner.xcodeproj', 'project.pbxproj')).read()
        ids = [m.strip('"\'') for m in re.findall(r'PRODUCT_BUNDLE_IDENTIFIER\s*=\s*([^;\s]+)\s*;', src) if '$' not in m]
        if ids:
            return min(ids, key=len)
    except OSError:
        pass
    return None


def android_package(cwd):
    override = os.environ.get('CLAUDE_PLUGIN_OPTION_ANDROID_PACKAGE')
    if override:
        return override
    for name in ('build.gradle.kts', 'build.gradle'):
        try:
            src = open(os.path.join(cwd, 'android', 'app', name)).read()
        except OSError:
            continue
        m = re.search(r'applicationId\s*=?\s*["\']([\w.]+)["\']', src)
        if m:
            return m.group(1)
    return None


def prepare_attach_cmd(key, cwd, extra):
    if IOS_SIM_RE.match(key):
        bid = ios_bundle_id(cwd)
        if bid:
            p = subprocess.run(['xcrun', 'simctl', 'launch', '--terminate-running-process', key, bid],
                               capture_output=True, text=True, timeout=20)
            if p.returncode == 0:
                return ['flutter', 'attach', '-d', key, *extra], None
        app_bin = os.path.join(cwd, 'build', 'ios', 'iphonesimulator', 'Runner.app')
        if os.path.isdir(app_bin):
            return ['flutter', 'run', '-d', key, '--use-application-binary=build/ios/iphonesimulator/Runner.app', *extra], None
        return None, f'{key}: app ({bid or "Runner"}) is not installed on this simulator. Run `{TOOL} run {key}` once to build and install it.'
    if IOS_DEV_RE.match(key):
        p = subprocess.run(['xcrun', 'devicectl', 'device', 'info', 'processes', '--device', key, '-t', '10'],
                           capture_output=True, text=True, timeout=15)
        if p.returncode == 0 and 'Runner.app' in p.stdout:
            return ['flutter', 'attach', '-d', key, *extra], None
        app_bin = os.path.join(cwd, 'build', 'ios', 'iphoneos', 'Runner.app')
        if os.path.isdir(app_bin):
            return ['flutter', 'run', '-d', key, '--use-application-binary=build/ios/iphoneos/Runner.app', *extra], None
        return None, (f'{key}: app is not running on this iOS device and build/ios/iphoneos/Runner.app was not found. '
                      f'Run `{TOOL} run {key}` once to build and install it.')
    pkg = android_package(cwd)
    if pkg:
        p = subprocess.run(['adb', '-s', key, 'shell', 'monkey', '-p', pkg, '-c', 'android.intent.category.LAUNCHER', '1'],
                           capture_output=True, text=True, timeout=15)
        if p.returncode != 0 or 'No activities found' in (p.stdout + p.stderr):
            return None, f'{key}: app ({pkg}) is not installed on this Android device. Run `{TOOL} run {key}` once to build and install it.'
    return ['flutter', 'attach', '-d', key, *extra], None


def _start_or_attach(key, extra, me, purpose, cmd_list, wait_sec):
    cwd = os.getcwd()
    with Ledger() as led:
        d, why = take(led, key, me, purpose)
        if why:
            sys.exit(why)
        app = d.get('app')
        if app and alive(app['pid']) and app.get('uri'):
            print(describe(key, d, me) + f'\n-> My app is already running. Do not rebuild — hot reload / restart through Marionette.')
            return
        starting = app if app and alive(app['pid']) else None
        if not starting:
            proc, log = _launch(key, d, cwd, extra, cmd_list)
    if starting:
        # The call that started this app was cut off (e.g. its time limit) before the VM address appeared: wait for that same app.
        pid = starting['pid']
        print(f"{key}: the app started {starting['started']} is still starting — waiting for its VM address (log: {starting['log']}).")
        _await_app(key, me, pid, lambda: alive(pid), starting['log'], wait_sec)
    else:
        _await_app(key, me, proc.pid, lambda: proc.poll() is None, log, wait_sec)


def _launch(key, d, cwd, extra, cmd_list):
    if cmd_list is None:
        cmd_list, err = prepare_attach_cmd(key, cwd, extra)
        if err:
            sys.exit(err)
    os.makedirs(STATE, exist_ok=True)
    tag = re.sub(r'[^A-Za-z0-9_.-]', '_', key)
    fifo, log = os.path.join(STATE, f'{tag}.stdin'), os.path.join(STATE, f'{tag}.log')
    if os.path.exists(fifo):
        os.remove(fifo)
    os.mkfifo(fifo)
    flutter = ' '.join([repr(a) if ' ' in a else a for a in cmd_list])
    proc = subprocess.Popen(['bash', '-c', f'exec 3<>"{fifo}"; exec {flutter} <&3 >"{log}" 2>&1'],
                            cwd=cwd, start_new_session=True)
    d['app'] = {'pid': proc.pid, 'fifo': fifo, 'log': log, 'uri': None, 'ws': None, 'started': now(),
                'cwd': cwd, **git_info(cwd)}
    return proc, log


def _await_app(key, me, pid, running, log, wait_sec):
    deadline = time.time() + wait_sec
    uri = None
    while time.time() < deadline:
        if not running():
            break
        try:
            m = URI_RE.search(open(log, errors='replace').read())
        except OSError:
            m = None
        if m:
            uri = m.group(1)
            break
        time.sleep(2)
    with Ledger() as led:
        d = led.devices.get(key)
        app = d.get('app') if d else None
        if app and app['pid'] != pid:
            app = None
        if uri and app:
            app['uri'] = uri
            app['ws'] = 'ws://' + uri[len('http://'):] + 'ws'
            print(describe(key, d, me))
            return
        tail = subprocess.run(['tail', '-30', log], capture_output=True, text=True).stdout
        if app:
            stop_app(app)
            d['app'] = None
        sys.exit(f'{key}: the app did not start (failed or over {wait_sec} s). You still own the device — '
                 f'`{TOOL} release {key}` if you are done.\n{tail}')


def cmd_run(args, me):
    key, extra = args[0], args[1:]
    _start_or_attach(key, extra, me, 'flutter run', ['flutter', 'run', '-d', key, *extra], RUN_WAIT_SEC)


def cmd_attach(args, me):
    key, extra = args[0], args[1:]
    wait_sec = ATTACH_WAIT_SEC if not IOS_DEV_RE.match(key) else 180
    _start_or_attach(key, extra, me, 'flutter attach', None, wait_sec)


def cmd_exec(args, me, auto_release=False):
    if '--' not in args:
        sys.exit(f'usage: {TOOL} exec <device> -- <command>')
    i = args.index('--')
    key, cmd = args[0], args[i + 1:]
    with Ledger() as led:
        _d, why = take(led, key, me, ' '.join(cmd)[:80])
        if why:
            sys.exit(why)
    code = subprocess.call(cmd)
    if auto_release:
        with Ledger() as led:
            if key in led.devices and led.devices[key].get('owner') and led.devices[key]['owner']['pid'] == me['pid']:
                print(free_device(led, key))
    sys.exit(code)


def cmd_emu(args, me):
    avd = args[0]

    def adb_emulators():
        out = subprocess.run(['adb', 'devices'], capture_output=True, text=True, timeout=15).stdout
        return set(re.findall(r'^(emulator-\d+)\s', out, re.M))

    before = adb_emulators()
    proc = subprocess.Popen(['emulator', '-avd', avd, '-no-snapshot-save'], stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True)
    serial = None
    for _ in range(90):
        new = adb_emulators() - before
        if new:
            serial = sorted(new)[0]
            break
        if proc.poll() is not None:
            break
        time.sleep(2)
    if not serial:
        sys.exit(f'Could not boot emulator {avd}.')
    with Ledger() as led:
        d, why = take(led, serial, me, f'emulator {avd}')
        if why:
            sys.exit(why)
        d['emulator_pid'] = proc.pid
        print(describe(serial, d, me) + f'\n-> start the app with {TOOL} run {serial}')


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ('-h', '--help', 'help'):
        print(__doc__)
        return
    cmd, args, me = sys.argv[1], sys.argv[2:], session()
    if cmd == 'status':
        cmd_status(args, me)
    elif cmd == 'wait' and args:
        cmd_wait(args, me)
    elif cmd == 'release-all':
        cmd_release_all(args, me)
    elif cmd == 'release' and args:
        cmd_release(args, me)
    elif cmd == 'stop' and args:
        cmd_stop(args, me)
    elif cmd == 'reload' and args:
        cmd_send(args, me, 'r')
    elif cmd == 'restart' and args:
        cmd_send(args, me, 'R')
    elif cmd == 'attach' and args:
        cmd_attach(args, me)
    elif cmd == 'run' and args:
        cmd_run(args, me)
    elif cmd == 'exec' and args:
        cmd_exec(args, me)
    elif cmd == 'build' and args:
        cmd_exec(['build', *args], me, auto_release=True)
    elif cmd == 'emu' and args:
        cmd_emu(args, me)
    else:
        sys.exit(__doc__)


if __name__ == '__main__':
    main()
